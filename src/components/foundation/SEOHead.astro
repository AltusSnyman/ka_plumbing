---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  additionalSchemas?: Record<string, any>[];
}

const { title, description, ogImage = '/images/og-default.webp', canonicalUrl, additionalSchemas } = Astro.props;
const siteUrl = 'https://kaplumbingltd.co.nz';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const canonical = canonicalUrl || Astro.url.href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="KA Plumbing LTD" />
<meta property="og:locale" content="en_NZ" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- Geo -->
<meta name="geo.region" content="NZ-AUK" />
<meta name="geo.placename" content="Auckland" />

<!-- Local Business JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Plumber",
  "name": "KA Plumbing LTD",
  "description": "Trusted, locally owned plumbing and drain laying services in Auckland. Certified plumber and drain layer offering 24/7 emergency service.",
  "url": siteUrl,
  "telephone": "+64-21-277-9151",
  "email": "KAPlumbingLtd@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Auckland",
    "addressRegion": "Auckland",
    "addressCountry": "NZ"
  },
  "areaServed": {
    "@type": "City",
    "name": "Auckland"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "08:00",
      "closes": "14:00"
    }
  ],
  "priceRange": "$$",
  "image": `${siteUrl}/images/logos/logo-square.webp`,
  "sameAs": [],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "6",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    { "@type": "Review", "author": { "@type": "Person", "name": "Sarah M." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Kurt was fantastic! He arrived on time, diagnosed the issue quickly, and had our burst pipe fixed within the hour. Highly recommend KA Plumbing." },
    { "@type": "Review", "author": { "@type": "Person", "name": "James T." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "We use KA Plumbing for all our rental properties. Kurt is reliable, professional, and always communicates clearly. Best plumber in Auckland." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Maria L." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Kurt handled our entire centre's plumbing upgrade with minimal disruption. His attention to safety and compliance was impressive." },
    { "@type": "Review", "author": { "@type": "Person", "name": "David R." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Complete bathroom renovation done beautifully. Kurt's workmanship is top quality and he kept us informed every step of the way." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Lisa & Mark W." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Kurt did all the plumbing and drainage for our new build. Professional, certified, and the work passed inspection first time." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Tony P." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Emergency call-out on a Saturday night — Kurt was there within 30 minutes. Saved us from flooding. Absolute legend." }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Plumbing Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Plumbing Repair" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Renovations & Maintenance" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "New Installations" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Hot Water Systems" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Drain Laying" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Consulting" } }
    ]
  }
})} />

{additionalSchemas?.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
