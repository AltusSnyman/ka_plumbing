---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white">
  <div class="max-w-[1200px] mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4">
          <img src="/images/logos/logo-round.webp" alt="KA Plumbing LTD" width="48" height="48" class="rounded-full" />
          <span class="font-heading text-h4 text-white">KA Plumbing</span>
        </a>
        <p class="text-white/70 text-sm leading-relaxed mb-6">
          Trusted, locally owned plumbing and drain laying services in Auckland.
          Certified plumber and drain layer — available 24/7.
        </p>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 rounded-full text-xs font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Certified Plumber
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 rounded-full text-xs font-semibold">
            Drain Layer
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading text-h4 text-white mb-4">Quick Links</h4>
        <ul class="space-y-4">
          {[
            { href: '/', label: 'Home' },
            { href: '/services/', label: 'Services' },
            { href: '/about/', label: 'About Kurt' },
            { href: '/contact/', label: 'Contact Us' },
            { href: '/booking/', label: 'Book a Service' },
            { href: '/blog/', label: 'Blog' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading text-h4 text-white mb-4">Services</h4>
        <ul class="space-y-4">
          {[
            { href: '/services/plumbing-repair/', label: 'Plumbing Repair' },
            { href: '/services/renovations/', label: 'Renovations & Maintenance' },
            { href: '/services/new-installations/', label: 'New Installations' },
            { href: '/services/hot-water/', label: 'Hot Water Systems' },
            { href: '/services/drain-laying/', label: 'Drain Laying' },
            { href: '/services/consulting/', label: 'Consulting' },
          ].map(service => (
            <li>
              <a href={service.href} class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sectors -->
      <div>
        <h4 class="font-heading text-h4 text-white mb-4">Sectors</h4>
        <ul class="space-y-4">
          {[
            { href: '/sectors/residential/', label: 'Residential' },
            { href: '/sectors/commercial/', label: 'Commercial' },
            { href: '/sectors/developers/', label: 'Developers' },
            { href: '/sectors/retail/', label: 'Stores & Shops' },
          ].map(sector => (
            <li>
              <a href={sector.href} class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
                {sector.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/sectors/" class="text-accent hover:underline text-sm font-semibold cursor-pointer">
              All Sectors &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h4 class="font-heading text-h4 text-white mb-4">Service Areas</h4>
        <ul class="space-y-4">
          <li>
            <a href="/areas/auckland/" class="text-white font-semibold hover:text-accent transition-colors text-sm cursor-pointer">
              Auckland
            </a>
          </li>
          <li class="pl-3">
            <a href="/areas/north-shore/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              North Shore
            </a>
          </li>
          <li class="pl-3">
            <a href="/areas/auckland-cbd/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              Auckland CBD
            </a>
          </li>
          <li class="border-t border-white/10 pt-3">
            <a href="/areas/takapuna/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              Takapuna
            </a>
          </li>
          <li>
            <a href="/areas/albany/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              Albany
            </a>
          </li>
          <li>
            <a href="/areas/browns-bay/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              Browns Bay
            </a>
          </li>
          <li>
            <a href="/areas/glenfield/" class="text-white/70 hover:text-accent transition-colors text-sm cursor-pointer">
              Glenfield
            </a>
          </li>
          <li>
            <a href="/areas/auckland/" class="text-accent hover:underline text-sm font-semibold cursor-pointer">
              All 40+ Areas &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-heading text-h4 text-white mb-4">Get In Touch</h4>
        <ul class="space-y-4">
          <li>
            <a href="tel:+64212779151" class="flex items-center gap-3 text-white/70 hover:text-accent transition-colors cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span class="text-sm">021 277 9151</span>
            </a>
          </li>
          <li>
            <a href="mailto:KAPlumbingLtd@gmail.com" class="flex items-center gap-3 text-white/70 hover:text-accent transition-colors cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="text-sm">KAPlumbingLtd@gmail.com</span>
            </a>
          </li>
          <li class="flex items-center gap-3 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-sm">Auckland, New Zealand</span>
          </li>
          <li class="flex items-center gap-3 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="text-sm">Available 24/7 for Emergencies</span>
          </li>
        </ul>

        <a href="tel:+64212779151" class="btn-emergency !text-sm mt-6 w-full justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Emergency? Call Now
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/50 text-sm">
        &copy; {currentYear} KA Plumbing LTD. All rights reserved.
      </p>
      <p class="text-white/50 text-xs">
        Auckland's Trusted Plumber &amp; Drain Layer
      </p>
    </div>
  </div>
</footer>
