---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/booking/', label: 'Book Now' },
];

const serviceLinks = [
  { href: '/services/', label: 'All Services' },
  { href: '/services/plumbing-repair/', label: 'Plumbing Repair' },
  { href: '/services/renovations/', label: 'Renovations' },
  { href: '/services/new-installations/', label: 'New Installations' },
  { href: '/services/hot-water/', label: 'Hot Water Systems' },
  { href: '/services/drain-laying/', label: 'Drain Laying' },
  { href: '/services/consulting/', label: 'Consulting' },
];

const sectorLinks = [
  { href: '/sectors/', label: 'All Sectors' },
  { href: '/sectors/residential/', label: 'Residential' },
  { href: '/sectors/commercial/', label: 'Commercial' },
  { href: '/sectors/developers/', label: 'Developers' },
  { href: '/sectors/retail/', label: 'Stores & Shops' },
];

const blogLinks = [
  { href: '/blog/', label: 'All Articles' },
  { href: '/blog/burst-pipe-auckland/', label: 'Burst Pipe Guide' },
  { href: '/blog/blocked-drain-causes-prevention/', label: 'Blocked Drains' },
  { href: '/blog/low-water-pressure-auckland/', label: 'Low Water Pressure' },
  { href: '/blog/hot-water-cylinder-problems/', label: 'Hot Water Problems' },
];

const isServicePage = currentPath.startsWith('/services');
const isSectorPage = currentPath.startsWith('/sectors');
const isBlogPage = currentPath.startsWith('/blog');
---

<nav class="glass-nav fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-[1200px] mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" aria-label="KA Plumbing Home">
      <img
        src="/images/logos/logo-round.webp"
        alt="KA Plumbing LTD Logo"
        width="44"
        height="44"
        class="rounded-full transition-transform duration-300 group-hover:scale-105"
      />
      <span class="font-heading text-h4 text-primary hidden sm:block">KA Plumbing</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-8">
      <a
        href="/"
        class:list={[
          'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer',
          currentPath === '/' ? 'text-accent' : 'text-primary hover:text-accent',
        ]}
      >
        Home
      </a>

      <!-- Services Dropdown -->
      <div class="relative group/services">
        <a
          href="/services/"
          class:list={[
            'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer flex items-center gap-1',
            isServicePage ? 'text-accent' : 'text-primary hover:text-accent',
          ]}
        >
          Services
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/services:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/services:opacity-100 group-hover/services:visible transition-all duration-200">
          <div class="glass-card-solid rounded-xl shadow-lg py-2 min-w-[220px] border border-primary/10">
            {serviceLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block px-5 py-2.5 text-sm font-medium transition-colors duration-150',
                  currentPath === link.href || currentPath === link.href.slice(0, -1)
                    ? 'text-accent bg-accent/5'
                    : 'text-primary hover:text-accent hover:bg-accent/5',
                  link.href === '/services/' && 'border-b border-primary/5 mb-1 font-semibold',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Sectors Dropdown -->
      <div class="relative group/sectors">
        <a
          href="/sectors/"
          class:list={[
            'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer flex items-center gap-1',
            isSectorPage ? 'text-accent' : 'text-primary hover:text-accent',
          ]}
        >
          Sectors
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/sectors:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/sectors:opacity-100 group-hover/sectors:visible transition-all duration-200">
          <div class="glass-card-solid rounded-xl shadow-lg py-2 min-w-[220px] border border-primary/10">
            {sectorLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block px-5 py-2.5 text-sm font-medium transition-colors duration-150',
                  currentPath === link.href || currentPath === link.href.slice(0, -1)
                    ? 'text-accent bg-accent/5'
                    : 'text-primary hover:text-accent hover:bg-accent/5',
                  link.href === '/sectors/' && 'border-b border-primary/5 mb-1 font-semibold',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog Dropdown -->
      <div class="relative group/blog">
        <a
          href="/blog/"
          class:list={[
            'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer flex items-center gap-1',
            isBlogPage ? 'text-accent' : 'text-primary hover:text-accent',
          ]}
        >
          Blog
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/blog:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/blog:opacity-100 group-hover/blog:visible transition-all duration-200">
          <div class="glass-card-solid rounded-xl shadow-lg py-2 min-w-[220px] border border-primary/10">
            {blogLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block px-5 py-2.5 text-sm font-medium transition-colors duration-150',
                  currentPath === link.href || currentPath === link.href.slice(0, -1)
                    ? 'text-accent bg-accent/5'
                    : 'text-primary hover:text-accent hover:bg-accent/5',
                  link.href === '/blog/' && 'border-b border-primary/5 mb-1 font-semibold',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/about/"
        class:list={[
          'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer',
          currentPath === '/about' ? 'text-accent' : 'text-primary hover:text-accent',
        ]}
      >
        About
      </a>

      <a
        href="/contact/"
        class:list={[
          'text-sm font-semibold uppercase tracking-wider transition-colors duration-200 cursor-pointer',
          currentPath === '/contact' ? 'text-accent' : 'text-primary hover:text-accent',
        ]}
      >
        Contact
      </a>

      <a
        href="/booking/"
        class="btn-primary !text-sm !py-2 !px-5 cursor-pointer"
      >
        Book Now
      </a>
    </div>

    <!-- Phone + Mobile Menu -->
    <div class="flex items-center gap-4">
      <a
        href="tel:+64212779151"
        class="flex items-center gap-2 text-primary font-semibold text-sm hover:text-accent transition-colors cursor-pointer"
        aria-label="Call KA Plumbing"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span class="hidden md:inline">021 277 9151</span>
      </a>

      <!-- Mobile Hamburger -->
      <button
        class="lg:hidden p-2 cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        id="mobile-menu-toggle"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="hamburger-icon"><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="close-icon" class="hidden"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-surface border-t border-primary/5">
    <div class="px-6 py-4 flex flex-col gap-2">
      <a href="/" class:list={['text-base font-semibold py-2 transition-colors cursor-pointer', currentPath === '/' ? 'text-accent' : 'text-primary hover:text-accent']}>
        Home
      </a>

      <!-- Mobile Services Accordion -->
      <details class="group/mobile-services">
        <summary class:list={['text-base font-semibold py-2 transition-colors cursor-pointer flex items-center justify-between list-none', isServicePage ? 'text-accent' : 'text-primary hover:text-accent']}>
          Services
          <svg class="w-4 h-4 transition-transform duration-200 group-open/mobile-services:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-1">
          {serviceLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-sm py-1.5 transition-colors cursor-pointer',
                currentPath === link.href || currentPath === link.href.slice(0, -1)
                  ? 'text-accent font-semibold'
                  : 'text-text-muted hover:text-accent',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>

      <!-- Mobile Sectors Accordion -->
      <details class="group/mobile-sectors">
        <summary class:list={['text-base font-semibold py-2 transition-colors cursor-pointer flex items-center justify-between list-none', isSectorPage ? 'text-accent' : 'text-primary hover:text-accent']}>
          Sectors
          <svg class="w-4 h-4 transition-transform duration-200 group-open/mobile-sectors:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-1">
          {sectorLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-sm py-1.5 transition-colors cursor-pointer',
                currentPath === link.href || currentPath === link.href.slice(0, -1)
                  ? 'text-accent font-semibold'
                  : 'text-text-muted hover:text-accent',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>

      <!-- Mobile Blog Accordion -->
      <details class="group/mobile-blog">
        <summary class:list={['text-base font-semibold py-2 transition-colors cursor-pointer flex items-center justify-between list-none', isBlogPage ? 'text-accent' : 'text-primary hover:text-accent']}>
          Blog
          <svg class="w-4 h-4 transition-transform duration-200 group-open/mobile-blog:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-1">
          {blogLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-sm py-1.5 transition-colors cursor-pointer',
                currentPath === link.href || currentPath === link.href.slice(0, -1)
                  ? 'text-accent font-semibold'
                  : 'text-text-muted hover:text-accent',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>

      <a href="/about/" class:list={['text-base font-semibold py-2 transition-colors cursor-pointer', currentPath === '/about' ? 'text-accent' : 'text-primary hover:text-accent']}>
        About
      </a>
      <a href="/contact/" class:list={['text-base font-semibold py-2 transition-colors cursor-pointer', currentPath === '/contact' ? 'text-accent' : 'text-primary hover:text-accent']}>
        Contact
      </a>
      <a href="/booking/" class="btn-primary text-center !mt-2 cursor-pointer">
        Book Now
      </a>
      <a href="tel:+64212779151" class="btn-emergency text-center !mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        24/7 Emergency: 021 277 9151
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
