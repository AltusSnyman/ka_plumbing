<section class="py-section bg-surface" aria-label="About Kurt">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Image -->
      <div class="reveal">
        <div class="relative">
          <img
            src="/images/about/business-vehicle.jpg"
            alt="KA Plumbing work vehicle in Auckland"
            width="600"
            height="400"
            loading="lazy"
            class="rounded-xl shadow-card w-full object-cover"
          />
          <div class="absolute -bottom-4 -right-4 bg-accent text-white px-6 py-3 rounded-lg shadow-amber-glow font-semibold text-sm">
            Certified Plumber & Drain Layer
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="reveal">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Meet Kurt</span>
        <h2 class="font-heading text-h2 text-primary mb-6">
          Auckland's Plumber You Can Trust By Name
        </h2>
        <p class="text-text-muted leading-relaxed mb-4">
          Hi, I'm Kurt — the owner and operator of KA Plumbing LTD. As a certified plumber and drain layer,
          I take pride in delivering honest, quality workmanship to every home and business across Auckland.
        </p>
        <p class="text-text-muted leading-relaxed mb-8">
          When you call KA Plumbing, you're not getting a call centre — you're getting me.
          I personally oversee every job to ensure it's done right the first time.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="/about" class="btn-outline cursor-pointer">
            Learn More About Kurt
          </a>
          <a href="tel:+64212779151" class="flex items-center gap-2 text-primary font-semibold hover:text-accent transition-colors cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call Kurt Directly
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
