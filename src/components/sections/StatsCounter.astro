---
const stats = [
  { value: 10, suffix: '+', label: 'Years Experience', prefix: '' },
  { value: 500, suffix: '+', label: 'Projects Completed', prefix: '' },
  { value: 5, suffix: '.0', label: 'Star Rating', prefix: '' },
  { value: 24, suffix: '/7', label: 'Emergency Service', prefix: '' },
];
---

<section class="py-section-sm bg-primary relative overflow-hidden" aria-label="Statistics">
  <!-- Decorative gradient orbs -->
  <div class="absolute top-0 left-1/4 w-64 h-64 bg-primary-light/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-48 h-48 bg-accent/10 rounded-full blur-3xl"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 reveal-stagger">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="font-heading text-hero text-white mb-2">
            <span
              class="stat-counter"
              data-target={stat.value}
              data-suffix={stat.suffix}
              data-prefix={stat.prefix}
            >
              0
            </span>
          </div>
          <p class="text-white/70 text-sm font-medium uppercase tracking-wider">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
