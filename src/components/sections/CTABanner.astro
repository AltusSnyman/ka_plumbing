---
interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = 'Ready to Get Started?',
  subheadline = "Whether it's a small repair or a major renovation, Kurt is ready to help. Get a free, no-obligation quote today.",
} = Astro.props;
---

<section class="py-section bg-primary relative overflow-hidden" aria-label="Call to action">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary-light/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-accent/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-[800px] mx-auto px-6 text-center relative z-10 reveal">
    <h2 class="font-heading text-h2 text-white mb-4">{headline}</h2>
    <p class="text-white/70 leading-relaxed mb-8 max-w-xl mx-auto">{subheadline}</p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="/booking/" class="btn-primary text-lg cursor-pointer">
        Get a Free Quote
      </a>
      <a href="tel:+64212779151" class="btn-secondary text-lg cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Call 021 277 9151
      </a>
    </div>
  </div>
</section>
