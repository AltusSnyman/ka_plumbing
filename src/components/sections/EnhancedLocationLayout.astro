---
import ShutterText from '../ui/ShutterText.astro';
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import TestimonialScroller from './TestimonialScroller.astro';
import EmergencyBanner from './EmergencyBanner.astro';
import CTABanner from './CTABanner.astro';
import servicesData from '../../data/services.json';
import enhancedData from '../../data/locations-enhanced.json';

interface Props {
  location: any;
}

const { location } = Astro.props;

// Build location hierarchy links
const parentPage = location.parentPage ? enhancedData.find((l: any) => l.slug === location.parentPage.slug) : null;
const childPages = (location.childPages || []).map((slug: string) => enhancedData.find((l: any) => l.slug === slug)).filter(Boolean);
const siblingPages = (location.siblingPages || []).map((slug: string) => enhancedData.find((l: any) => l.slug === slug)).filter(Boolean);
const suburbPages = (location.suburbPages || []).map((slug: string) => enhancedData.find((l: any) => l.slug === slug)).filter(Boolean);

// Icon map for services
const iconMap: Record<string, string> = {
  'wrench': '<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M4.867 19.125h.008v.008h-.008v-.008Z" />',
  'hammer': '<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />',
  'plus-circle': '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
  'fire': '<path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />',
  'water': '<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />',
  'clipboard': '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />',
};
---

<!-- Hero -->
<section class="relative min-h-[60vh] flex items-center overflow-hidden" aria-label={location.heroHeadline}>
  <img
    src={location.heroImage}
    alt={`${location.name} — plumber and drain layer`}
    width="1920"
    height="1080"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-32 flex items-center justify-center w-full">
    <div class="hero-glass-card w-full max-w-[calc(100%-2rem)] md:max-w-2xl lg:max-w-3xl text-center px-6 py-10 md:px-14 md:py-14 rounded-2xl">
      <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">{location.region}</span>
      <h1 class="text-h2 md:text-h1 mb-4"><ShutterText text={location.heroHeadline} /></h1>
      <p class="text-text-muted max-w-lg mx-auto text-lg">{location.heroSubheadline}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a href="/booking" class="btn-primary">Get a Free Quote</a>
        <a href="tel:+64212779151" class="btn-outline">Call 021 277 9151</a>
      </div>
    </div>
  </div>
</section>

<!-- Intro -->
<section class="py-section bg-background" aria-label={location.introHeading}>
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-3xl mx-auto reveal">
      <h2 class="font-heading text-h3 text-primary mb-6">{location.introHeading}</h2>
      {location.introContent.map((para: string) => (
        <p class="text-text-muted text-lg leading-relaxed mb-6">{para}</p>
      ))}
    </div>
  </div>
</section>

<!-- Content Grid — alternating image + text rows -->
<section class="py-section bg-surface" aria-label={`Plumbing services in ${location.name}`}>
  <div class="max-w-[1200px] mx-auto px-6">
    {location.contentGrid.map((item: any, index: number) => (
      <div class={`flex flex-col lg:flex-row gap-10 items-center mb-16 last:mb-0 reveal ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
        <div class="lg:w-1/2">
          <img
            src={item.image}
            alt={item.imageAlt}
            width="600"
            height="600"
            loading="lazy"
            class="rounded-2xl w-full object-cover aspect-square"
          />
        </div>
        <div class="lg:w-1/2">
          <h3 class="font-heading text-h3 text-primary mb-4">{item.heading}</h3>
          <p class="text-text-muted text-lg leading-relaxed">{item.content}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Services Available -->
<section class="py-section bg-background" aria-label="Available services">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Our Services</span>
      <h2 class="font-heading text-h3 text-primary mb-4">Services Available in {location.name}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
      {servicesData.map((service: any) => (
        <a href={`/services/${service.id}/`} class="glass-card-solid p-6 hover:border-accent/30 transition-colors group">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={iconMap[service.icon] || iconMap['wrench']} />
          </div>
          <h3 class="font-heading text-primary group-hover:text-accent transition-colors mb-2">{service.title}</h3>
          <p class="text-text-muted text-sm">{service.subtitle}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Why Choose KA Plumbing -->
<section class="py-section bg-surface" aria-label={`Why choose KA Plumbing in ${location.name}`}>
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-3xl mx-auto reveal">
      <div class="text-center mb-10">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Why KA Plumbing</span>
        <h2 class="font-heading text-h3 text-primary">Why {location.name} Chooses KA Plumbing</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {location.whyChoose.map((item: { title: string; desc: string }) => (
          <div class="glass-card-solid p-6">
            <h3 class="font-heading text-primary mb-2">{item.title}</h3>
            <p class="text-text-muted text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Location Hierarchy — links between all 7 enhanced pages -->
<section class="py-section bg-background" aria-label="Service areas">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-3xl mx-auto reveal">
      <div class="text-center mb-10">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Service Areas</span>
        <h2 class="font-heading text-h3 text-primary">Explore Our Auckland Service Areas</h2>
      </div>

      {/* Parent page link */}
      {parentPage && (
        <div class="mb-6">
          <p class="text-text-muted text-sm mb-2">Part of:</p>
          <a href={`/areas/${parentPage.slug}/`} class="glass-card-solid p-4 flex items-center gap-3 hover:border-accent/30 transition-colors group">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="font-heading text-primary group-hover:text-accent transition-colors">{parentPage.name}</span>
          </a>
        </div>
      )}

      {/* Child region pages (for city page) */}
      {childPages.length > 0 && (
        <div class="mb-6">
          <p class="text-text-muted text-sm mb-3">Regions:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {childPages.map((child: any) => (
              <a href={`/areas/${child.slug}/`} class="glass-card-solid p-5 hover:border-accent/30 transition-colors group">
                <h3 class="font-heading text-primary group-hover:text-accent transition-colors mb-1">{child.name}</h3>
                <p class="text-text-muted text-sm">Response time: {child.responseTime}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* Suburb pages (for region pages) */}
      {suburbPages.length > 0 && (
        <div class="mb-6">
          <p class="text-text-muted text-sm mb-3">Featured Suburbs:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {suburbPages.map((sub: any) => (
              <a href={`/areas/${sub.slug}/`} class="glass-card-solid p-5 hover:border-accent/30 transition-colors group">
                <h3 class="font-heading text-primary group-hover:text-accent transition-colors mb-1">{sub.name}</h3>
                <p class="text-text-muted text-sm">Response time: {sub.responseTime}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* Sibling pages */}
      {siblingPages.length > 0 && (
        <div class="mb-6">
          <p class="text-text-muted text-sm mb-3">{location.pageType === 'suburb' ? 'Other North Shore Suburbs:' : 'Also see:'}</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {siblingPages.map((sib: any) => (
              <a href={`/areas/${sib.slug}/`} class="glass-card-solid p-5 hover:border-accent/30 transition-colors group">
                <h3 class="font-heading text-primary group-hover:text-accent transition-colors mb-1">{sib.name}</h3>
                <p class="text-text-muted text-sm">Response time: {sib.responseTime}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<!-- Nearby Areas (thin pages) -->
{location.nearbyThinSlugs && location.nearbyThinSlugs.length > 0 && (
  <section class="py-section bg-surface" aria-label="Nearby service areas">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="font-heading text-h3 text-primary mb-6">Also Serving Nearby</h2>
        <div class="flex flex-wrap gap-3">
          {location.nearbyThinSlugs.map((slug: string) => {
            const name = slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            return (
              <a
                href={`/areas/${slug}/`}
                title={`Plumber in ${name}, Auckland`}
                class="inline-block px-4 py-2 bg-primary/5 text-primary text-sm font-medium rounded-full hover:bg-accent/10 hover:text-accent transition-colors"
              >
                {name}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}

<!-- FAQs -->
<section class="py-section bg-background" aria-label="Frequently asked questions">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 reveal">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">FAQ</span>
        <h2 class="font-heading text-h3 text-primary">Common Questions — {location.name}</h2>
      </div>
      <div class="space-y-4 reveal">
        {location.faqs.map((faq: { q: string; a: string }) => (
          <details class="glass-card-solid group">
            <summary class="p-6 cursor-pointer flex items-center justify-between gap-4 font-semibold text-primary list-none">
              <span>{faq.q}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-muted text-sm leading-relaxed border-t border-primary/5 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Bottom Sections -->
<BeforeAfterSlider />
<TestimonialScroller />
<CTABanner
  headline={`Need a Plumber in ${location.name}?`}
  subheadline="Get a free, no-obligation quote. Kurt personally responds to every enquiry."
/>
<EmergencyBanner />
