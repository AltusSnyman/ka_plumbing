---
const suburbs = [
  'Mt Eden', 'Ponsonby', 'Grey Lynn', 'Remuera', 'Parnell',
  'Newmarket', 'Epsom', 'Mt Albert', 'Avondale', 'Henderson',
  'New Lynn', 'Titirangi', 'Glen Eden', 'Te Atatu', 'Westmere',
  'Herne Bay', 'CBD', 'Grafton', 'Onehunga', 'Royal Oak',
  'Mt Roskill', 'Sandringham', 'Kingsland', 'Morningside', 'Blockhouse Bay',
];
---

<section class="py-section bg-surface" aria-label="Service areas in Auckland">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Service Area</span>
      <h2 class="font-heading text-h2 text-primary mb-4">Serving All of Auckland</h2>
      <p class="text-text-muted max-w-xl mx-auto">
        From the CBD to the Western suburbs, KA Plumbing covers all of Auckland.
        No job is too far — we come to you with our fully equipped service vehicle.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Google Map -->
      <div class="reveal">
        <div class="glass-card-solid overflow-hidden h-full min-h-[400px]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d204880.73498474836!2d174.57144773828125!3d-36.86249099999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d0d47fb5a9ce6fb%3A0x500ef6143a29917!2sAuckland%2C%20New%20Zealand!5e0!3m2!1sen!2snz!4v1711900000000!5m2!1sen!2snz"
            width="100%"
            height="100%"
            style="border:0; min-height:400px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="KA Plumbing service area — Auckland, New Zealand"
          ></iframe>
        </div>
      </div>

      <!-- Suburbs Grid -->
      <div class="reveal flex flex-col gap-6">
        <div class="glass-card-solid p-8 flex-1">
          <h3 class="font-heading text-h4 text-primary mb-4">Areas We Cover</h3>
          <div class="flex flex-wrap gap-2">
            {suburbs.map((suburb) => (
              <span class="inline-block px-3 py-1.5 bg-primary/5 text-primary text-xs font-medium rounded-full hover:bg-accent/10 hover:text-accent transition-colors cursor-default">
                {suburb}
              </span>
            ))}
          </div>
          <p class="text-text-muted text-xs mt-4">
            Don't see your area? <a href="/contact" class="text-accent hover:underline cursor-pointer">Contact us</a> — we likely cover it.
          </p>
        </div>

        <a href="/booking" class="btn-primary cursor-pointer self-start">
          Book a Service in Your Area
        </a>
      </div>
    </div>
  </div>
</section>
