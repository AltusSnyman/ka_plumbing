---
const trustItems = [
  { icon: 'shield', label: 'Certified Plumber & Drain Layer' },
  { icon: 'clock', label: '24/7 Emergency Service' },
  { icon: 'map-pin', label: 'Locally Owned — Auckland' },
  { icon: 'star', label: '5-Star Rated Service' },
];
---

<section class="bg-primary text-white py-2.5 fixed top-[72px] left-0 right-0 z-40" aria-label="Trust indicators">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-4 md:gap-x-8 gap-y-2">
      {trustItems.map((item) => (
        <div class="flex items-center gap-2 text-sm font-medium text-white/90">
          {item.icon === 'shield' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          )}
          {item.icon === 'clock' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          )}
          {item.icon === 'map-pin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          )}
          {item.icon === 'star' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          )}
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
