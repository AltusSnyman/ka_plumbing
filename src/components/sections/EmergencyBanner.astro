<section class="py-12 bg-emergency relative overflow-hidden" aria-label="Emergency plumbing service">
  <!-- Pulsing background effect -->
  <div class="absolute inset-0 bg-gradient-to-r from-emergency-dark via-emergency to-emergency-dark opacity-50"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-white">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 animate-pulse">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <div>
          <h2 class="font-heading text-h3 text-white">Plumbing Emergency?</h2>
          <p class="text-white/80 text-sm">Burst pipe, flooding, or blocked drain? Kurt is available 24/7 — fast response across Auckland.</p>
        </div>
      </div>

      <a href="tel:+64212779151" class="inline-flex items-center gap-3 px-8 py-4 bg-white text-emergency font-bold text-lg rounded-full shadow-lg hover:scale-105 transition-transform cursor-pointer whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Call Now: 021 277 9151
      </a>
    </div>
  </div>
</section>
