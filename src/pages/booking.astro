---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Book a Plumber Auckland — KA Plumbing LTD | Free Quote"
  description="Book a plumbing service with KA Plumbing LTD in Auckland. Easy online booking for repairs, renovations, hot water, drain laying, and more. Free quotes available."
>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden" aria-label="Booking hero">
    <img
      src="/images/backgrounds/kitchen.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-32 flex items-center justify-center w-full">
      <div class="hero-glass-card w-full max-w-[calc(100%-2rem)] md:max-w-2xl lg:max-w-3xl text-center px-6 py-10 md:px-14 md:py-14 rounded-2xl">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Book Online</span>
        <h1 class="font-heading text-h1 text-primary mb-4">Book a Plumbing Service</h1>
        <p class="text-text-muted max-w-md mx-auto text-lg">Complete the form below for a free quote. Need it urgent? <a href="tel:+64212779151" class="text-accent hover:underline font-semibold">Call 021 277 9151</a>.</p>
      </div>
    </div>
  </section>

  <!-- Multi-step Booking Form -->
  <section class="py-section bg-background" aria-label="Booking form">
    <div class="max-w-[800px] mx-auto px-6">
      <!-- Progress Bar -->
      <div class="mb-10 reveal">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2" data-step-indicator="1">
            <div class="w-8 h-8 rounded-full bg-accent text-white font-bold text-sm flex items-center justify-center">1</div>
            <span class="text-sm font-semibold text-primary hidden sm:inline">Service</span>
          </div>
          <div class="flex-1 h-0.5 bg-primary/10 mx-3" data-progress-line="1"></div>
          <div class="flex items-center gap-2" data-step-indicator="2">
            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary/40 font-bold text-sm flex items-center justify-center">2</div>
            <span class="text-sm font-semibold text-text-muted hidden sm:inline">Details</span>
          </div>
          <div class="flex-1 h-0.5 bg-primary/10 mx-3" data-progress-line="2"></div>
          <div class="flex items-center gap-2" data-step-indicator="3">
            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary/40 font-bold text-sm flex items-center justify-center">3</div>
            <span class="text-sm font-semibold text-text-muted hidden sm:inline">Confirm</span>
          </div>
        </div>
      </div>

      <div class="glass-card-solid p-8 reveal">
        <form id="booking-form">
          <!-- Step 1: Service -->
          <div data-step="1">
            <h2 class="font-heading text-h3 text-primary mb-6">What do you need help with?</h2>

            <div class="space-y-5">
              <div>
                <label for="service-type" class="block text-sm font-semibold text-primary mb-2">Service Type <span class="text-emergency">*</span></label>
                <select
                  id="service-type"
                  name="service-type"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors cursor-pointer"
                >
                  <option value="">Select a service...</option>
                  <option value="plumbing-repair">Plumbing Repair</option>
                  <option value="renovations">Renovations & Maintenance</option>
                  <option value="new-installations">New Installations</option>
                  <option value="hot-water">Hot Water Systems</option>
                  <option value="drain-laying">Drain Laying</option>
                  <option value="consulting">Consulting</option>
                  <option value="emergency">Emergency</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-semibold text-primary mb-2">How urgent is this?</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <label class="glass-card-solid p-4 text-center cursor-pointer has-[:checked]:border-accent has-[:checked]:bg-accent/5 transition-colors">
                    <input type="radio" name="urgency" value="emergency" class="sr-only" />
                    <span class="text-emergency font-bold text-sm">Emergency</span>
                    <p class="text-text-muted text-xs mt-1">Need help now</p>
                  </label>
                  <label class="glass-card-solid p-4 text-center cursor-pointer has-[:checked]:border-accent has-[:checked]:bg-accent/5 transition-colors">
                    <input type="radio" name="urgency" value="soon" class="sr-only" checked />
                    <span class="text-primary font-bold text-sm">Soon</span>
                    <p class="text-text-muted text-xs mt-1">Within a few days</p>
                  </label>
                  <label class="glass-card-solid p-4 text-center cursor-pointer has-[:checked]:border-accent has-[:checked]:bg-accent/5 transition-colors">
                    <input type="radio" name="urgency" value="flexible" class="sr-only" />
                    <span class="text-primary font-bold text-sm">Flexible</span>
                    <p class="text-text-muted text-xs mt-1">No rush</p>
                  </label>
                </div>
              </div>

              <button type="button" class="btn-primary w-full justify-center cursor-pointer" data-next-step>
                Next: Your Details
              </button>
            </div>
          </div>

          <!-- Step 2: Contact Details -->
          <div data-step="2" class="hidden">
            <h2 class="font-heading text-h3 text-primary mb-6">Your Contact Details</h2>

            <div class="space-y-5">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label for="booking-name" class="block text-sm font-semibold text-primary mb-2">Full Name <span class="text-emergency">*</span></label>
                  <input
                    type="text"
                    id="booking-name"
                    name="name"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="booking-phone" class="block text-sm font-semibold text-primary mb-2">Phone <span class="text-emergency">*</span></label>
                  <input
                    type="tel"
                    id="booking-phone"
                    name="phone"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                    placeholder="021 xxx xxxx"
                  />
                </div>
              </div>

              <div>
                <label for="booking-email" class="block text-sm font-semibold text-primary mb-2">Email</label>
                <input
                  type="email"
                  id="booking-email"
                  name="email"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                  placeholder="you@example.com"
                />
              </div>

              <div>
                <label for="booking-address" class="block text-sm font-semibold text-primary mb-2">Property Address</label>
                <input
                  type="text"
                  id="booking-address"
                  name="address"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                  placeholder="Street address, Auckland"
                />
              </div>

              <div>
                <label for="booking-date" class="block text-sm font-semibold text-primary mb-2">Preferred Date</label>
                <input
                  type="date"
                  id="booking-date"
                  name="date"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors cursor-pointer"
                />
              </div>

              <div class="flex gap-3">
                <button type="button" class="btn-outline flex-1 justify-center cursor-pointer" data-prev-step>
                  Back
                </button>
                <button type="button" class="btn-primary flex-1 justify-center cursor-pointer" data-next-step>
                  Next: Describe the Job
                </button>
              </div>
            </div>
          </div>

          <!-- Step 3: Description -->
          <div data-step="3" class="hidden">
            <h2 class="font-heading text-h3 text-primary mb-6">Tell Us About the Job</h2>

            <div class="space-y-5">
              <div>
                <label for="booking-description" class="block text-sm font-semibold text-primary mb-2">Description <span class="text-emergency">*</span></label>
                <textarea
                  id="booking-description"
                  name="description"
                  required
                  rows="5"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors resize-y"
                  placeholder="Describe the plumbing issue or work needed..."
                ></textarea>
                <p class="text-text-muted text-xs mt-1">Include details like the location in your property, any visible damage, and how long the issue has been occurring.</p>
              </div>

              <div class="flex gap-3">
                <button type="button" class="btn-outline flex-1 justify-center cursor-pointer" data-prev-step>
                  Back
                </button>
                <button type="submit" class="btn-primary flex-1 justify-center cursor-pointer">
                  Submit Booking Request
                </button>
              </div>
            </div>
          </div>

          <!-- Success -->
          <div data-step="success" class="hidden text-center py-8">
            <div class="w-16 h-16 rounded-full bg-success/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h2 class="font-heading text-h3 text-primary mb-3">Booking Request Sent!</h2>
            <p class="text-text-muted mb-6">Kurt will review your request and get back to you shortly with a free quote.</p>
            <a href="/" class="btn-primary cursor-pointer">Back to Home</a>
          </div>
        </form>
      </div>

      <!-- Trust Sidebar -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 reveal-stagger">
        <div class="glass-card-solid p-5 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8A04C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p class="text-sm font-semibold text-primary">Free Quotes</p>
          <p class="text-text-muted text-xs">No obligation, no hidden fees</p>
        </div>
        <div class="glass-card-solid p-5 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8A04C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <p class="text-sm font-semibold text-primary">Fast Response</p>
          <p class="text-text-muted text-xs">Usually within 1-2 hours</p>
        </div>
        <div class="glass-card-solid p-5 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8A04C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <p class="text-sm font-semibold text-primary">5-Star Service</p>
          <p class="text-text-muted text-xs">Trusted by hundreds of Aucklanders</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  let currentStep = 1;

  function showStep(step: number | string) {
    form.querySelectorAll('[data-step]').forEach((el) => {
      (el as HTMLElement).classList.toggle('hidden', el.getAttribute('data-step') !== String(step));
    });

    // Update progress indicators
    for (let i = 1; i <= 3; i++) {
      const indicator = document.querySelector(`[data-step-indicator="${i}"]`);
      const circle = indicator?.querySelector('div');
      const label = indicator?.querySelector('span');
      const line = document.querySelector(`[data-progress-line="${i}"]`);

      if (circle && typeof step === 'number') {
        if (i <= step) {
          circle.className = 'w-8 h-8 rounded-full bg-accent text-white font-bold text-sm flex items-center justify-center';
          if (label) label.className = 'text-sm font-semibold text-primary hidden sm:inline';
        } else {
          circle.className = 'w-8 h-8 rounded-full bg-primary/10 text-primary/40 font-bold text-sm flex items-center justify-center';
          if (label) label.className = 'text-sm font-semibold text-text-muted hidden sm:inline';
        }
      }
      if (line && typeof step === 'number') {
        (line as HTMLElement).className = i < step
          ? 'flex-1 h-0.5 bg-accent mx-3 transition-colors'
          : 'flex-1 h-0.5 bg-primary/10 mx-3 transition-colors';
      }
    }
  }

  form?.querySelectorAll('[data-next-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentStep++;
      showStep(currentStep);
    });
  });

  form?.querySelectorAll('[data-prev-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentStep--;
      showStep(currentStep);
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    showStep('success');
  });
</script>
