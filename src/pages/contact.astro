---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbSchema } from '../utils/breadcrumbs';
import ShutterText from '../components/ui/ShutterText.astro';
import EmergencyBanner from '../components/sections/EmergencyBanner.astro';
---

<BaseLayout
  title="Contact KA Plumbing LTD — Auckland Plumber | 021 277 9151"
  description="Contact KA Plumbing LTD for all your plumbing needs in Auckland. Call Kurt on 021 277 9151 or send us a message. Available 24/7 for emergencies."
  canonicalUrl="https://kaplumbingltd.co.nz/contact/"
  additionalSchemas={[buildBreadcrumbSchema([{ name: 'Contact', path: '/contact/' }])]}
>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden" aria-label="Contact hero">
    <img
      src="/images/backgrounds/pipes-business.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-32 flex items-center justify-center w-full">
      <div class="hero-glass-card w-full max-w-[calc(100%-2rem)] md:max-w-2xl lg:max-w-3xl text-center px-6 py-10 md:px-14 md:py-14 rounded-2xl">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">Get In Touch</span>
        <h1 class="text-h1 mb-4"><ShutterText text="Contact KA Plumbing" /></h1>
        <p class="text-text-muted max-w-md mx-auto text-lg">Have a question or need a quote? Kurt personally responds to every enquiry.</p>
      </div>
    </div>
  </section>

  <!-- Contact Form + Details -->
  <section class="py-section bg-background" aria-label="Contact form and details">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Form -->
        <div class="lg:col-span-3 reveal">
          <div class="glass-card-solid p-8">
            <h2 class="font-heading text-h3 text-primary mb-6">Send Us a Message</h2>
            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-semibold text-primary mb-2">Full Name <span class="text-emergency">*</span></label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-semibold text-primary mb-2">Phone <span class="text-emergency">*</span></label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                    placeholder="021 xxx xxxx"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-semibold text-primary mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                  placeholder="you@example.com"
                />
              </div>

              <div>
                <label for="service" class="block text-sm font-semibold text-primary mb-2">Service Needed</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors cursor-pointer"
                >
                  <option value="">Select a service...</option>
                  <option value="plumbing-repair">Plumbing Repair</option>
                  <option value="renovations">Renovations & Maintenance</option>
                  <option value="new-installations">New Installations</option>
                  <option value="hot-water">Hot Water Systems</option>
                  <option value="drain-laying">Drain Laying</option>
                  <option value="consulting">Consulting</option>
                  <option value="emergency">Emergency</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-semibold text-primary mb-2">Message <span class="text-emergency">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="w-full px-4 py-3 rounded-lg border border-primary/10 bg-background text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors resize-y"
                  placeholder="Tell us about your plumbing needs..."
                ></textarea>
              </div>

              <button type="submit" class="btn-primary w-full justify-center text-lg cursor-pointer">
                Send Message
              </button>

              <div id="form-status" class="hidden text-center py-3 rounded-lg text-sm font-semibold"></div>
            </form>
          </div>
        </div>

        <!-- Contact Details -->
        <div class="lg:col-span-2 reveal">
          <div class="space-y-6">
            <!-- Phone -->
            <a href="tel:+64212779151" class="glass-card-solid p-6 flex items-center gap-4 group cursor-pointer block">
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center flex-shrink-0 group-hover:bg-accent/20 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8A04C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Phone</p>
                <p class="text-accent font-bold">021 277 9151</p>
              </div>
            </a>

            <!-- Email -->
            <a href="mailto:KAPlumbingLtd@gmail.com" class="glass-card-solid p-6 flex items-center gap-4 group cursor-pointer block">
              <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/10 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Email</p>
                <p class="text-text-muted text-sm">KAPlumbingLtd@gmail.com</p>
              </div>
            </a>

            <!-- Location -->
            <div class="glass-card-solid p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Location</p>
                <p class="text-text-muted text-sm">Auckland, New Zealand</p>
              </div>
            </div>

            <!-- Hours -->
            <div class="glass-card-solid p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Business Hours</p>
                <p class="text-text-muted text-sm">Mon–Fri: 7am–6pm</p>
                <p class="text-text-muted text-sm">Sat: 8am–2pm</p>
                <p class="text-emergency text-sm font-semibold">24/7 Emergency Service</p>
              </div>
            </div>

            <!-- Emergency Card -->
            <div class="bg-emergency/5 border-2 border-emergency/20 rounded-xl p-6 text-center">
              <p class="font-heading text-h4 text-emergency mb-2">Plumbing Emergency?</p>
              <p class="text-text-muted text-sm mb-4">Don't wait — call Kurt now for immediate help.</p>
              <a href="tel:+64212779151" class="btn-emergency w-full justify-center cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                Call 021 277 9151
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <EmergencyBanner />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    status.classList.remove('hidden');
    status.className = 'text-center py-3 rounded-lg text-sm font-semibold bg-success/10 text-success';
    status.textContent = 'Thank you! Kurt will get back to you shortly.';
    form.reset();
    setTimeout(() => { status.classList.add('hidden'); }, 5000);
  });
</script>
