---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShutterText from '../../components/ui/ShutterText.astro';
import EmergencyBanner from '../../components/sections/EmergencyBanner.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../../utils/breadcrumbs';
import locationsData from '../../data/locations.json';
import servicesData from '../../data/services.json';

export function getStaticPaths() {
  return locationsData.map((location) => ({
    params: { suburb: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const siteUrl = 'https://kaplumbingltd.co.nz';

const nearbyLocations = locationsData.filter((l) => location.nearbySuburbs.includes(l.slug));

const faqs = [
  { q: `How fast can a plumber get to ${location.suburb}?`, a: `For plumbing emergencies in ${location.suburb}, Kurt typically arrives within ${location.responseTime}. For scheduled work, we offer flexible booking including weekends.` },
  { q: `Do you offer emergency plumbing in ${location.suburb}?`, a: `Yes — KA Plumbing provides 24/7 emergency plumbing services in ${location.suburb} and across Auckland's ${location.region}. Call 021 277 9151 anytime for burst pipes, flooding, or blocked drains.` },
  { q: `What plumbing and drain laying services are available in ${location.suburb}?`, a: `We offer the full range of plumbing and drain laying services in ${location.suburb}: repairs, renovations, new installations, hot water systems, drain laying, and consulting. Kurt is a certified plumber and certified drain layer.` },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: 'KA Plumbing LTD',
  url: siteUrl,
  telephone: '+64-21-277-9151',
  email: 'KAPlumbingLtd@gmail.com',
  areaServed: {
    '@type': 'Place',
    name: `${location.suburb}, Auckland`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: location.suburb,
      addressRegion: 'Auckland',
      addressCountry: 'NZ',
    },
  },
  description: `Professional plumber and certified drain layer serving ${location.suburb}, Auckland. 24/7 emergency plumbing, repairs, renovations, hot water, and drain laying.`,
};
---

<BaseLayout
  title={`Plumber in ${location.suburb} | Auckland Plumbing & Drain Laying | KA Plumbing LTD`}
  description={`Need a plumber in ${location.suburb}, Auckland? KA Plumbing offers emergency plumbing, drain laying, hot water repairs & renovations. Certified plumber. Call 021 277 9151.`}
  canonicalUrl={`${siteUrl}/areas/${location.slug}/`}
  additionalSchemas={[
    buildBreadcrumbSchema([
      { name: 'Areas', path: '/areas/' },
      { name: location.suburb, path: `/areas/${location.slug}/` },
    ]),
    buildFAQSchema(faqs),
    localBusinessSchema,
  ]}
>
  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden" aria-label={`Plumber in ${location.suburb}`}>
    <img
      src="/images/backgrounds/pipes-business.webp"
      alt={`Plumber in ${location.suburb}, Auckland`}
      width="1920"
      height="1080"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-32 flex items-center justify-center w-full">
      <div class="hero-glass-card w-full max-w-[calc(100%-2rem)] md:max-w-2xl lg:max-w-3xl text-center px-6 py-10 md:px-14 md:py-14 rounded-2xl">
        <span class="inline-block text-accent font-semibold text-sm uppercase tracking-widest mb-3">{location.region}</span>
        <h1 class="text-h1 mb-4"><ShutterText text={`Plumber & Drain Layer in ${location.suburb}`} /></h1>
        <p class="text-text-muted max-w-md mx-auto text-lg">Certified plumber and drain layer serving {location.suburb} and surrounding {location.region} suburbs.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href="/booking" class="btn-primary">Get a Free Quote</a>
          <a href="tel:+64212779151" class="btn-outline">Call 021 277 9151</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-section bg-background" aria-label={`Plumbing services in ${location.suburb}`}>
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="font-heading text-h3 text-primary mb-6">Plumbing Services in {location.suburb}, Auckland</h2>
        <p class="text-text-muted text-lg leading-relaxed mb-6">
          {location.description}
        </p>
        <p class="text-text-muted text-lg leading-relaxed mb-6">
          KA Plumbing LTD provides professional plumbing services in {location.suburb} and across Auckland's {location.region}. Whether you need an emergency plumber in {location.suburb} for a burst pipe, a certified drain layer for drainage work, or a reliable plumber for hot water repairs and bathroom renovations — Kurt has you covered. As both a certified plumber and certified drain layer, there's no need for a second contractor.
        </p>
        <p class="text-text-muted text-lg leading-relaxed">
          Response time to {location.suburb}: typically <strong>{location.responseTime}</strong> for emergencies. For scheduled plumbing work, we offer flexible booking including weekends.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Available -->
  <section class="py-section bg-surface" aria-label="Available services">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-10 reveal">
        <h2 class="font-heading text-h3 text-primary mb-4">Services Available in {location.suburb}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
        {servicesData.map((service) => (
          <a href={`/services/${service.id}/`} class="glass-card-solid p-6 hover:border-accent/30 transition-colors group">
            <h3 class="font-heading text-primary group-hover:text-accent transition-colors mb-2">{service.title}</h3>
            <p class="text-text-muted text-sm">{service.subtitle}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose KA Plumbing -->
  <section class="py-section bg-background" aria-label={`Why choose KA Plumbing in ${location.suburb}`}>
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="font-heading text-h3 text-primary mb-8">Why Choose KA Plumbing in {location.suburb}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {[
            { title: 'Fast Response', desc: `${location.responseTime} response time to ${location.suburb} for emergencies` },
            { title: 'Dual Certified', desc: 'Certified plumber AND certified drain layer — one contractor for everything' },
            { title: 'Free Quotes', desc: 'Upfront, no-obligation quotes with honest pricing — no hidden fees' },
            { title: '24/7 Emergency', desc: `Emergency plumber available around the clock for ${location.suburb} and all of ${location.region}` },
          ].map((item) => (
            <div class="glass-card-solid p-6">
              <h3 class="font-heading text-primary mb-2">{item.title}</h3>
              <p class="text-text-muted text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Areas -->
  {nearbyLocations.length > 0 && (
    <section class="py-section bg-surface" aria-label="Nearby service areas">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="max-w-3xl mx-auto reveal">
          <h2 class="font-heading text-h3 text-primary mb-6">Also Serving Nearby</h2>
          <div class="flex flex-wrap gap-3">
            {nearbyLocations.map((nearby) => (
              <a
                href={`/areas/${nearby.slug}/`}
                title={`Plumber in ${nearby.suburb}, Auckland`}
                class="inline-block px-4 py-2 bg-primary/5 text-primary text-sm font-medium rounded-full hover:bg-accent/10 hover:text-accent transition-colors"
              >
                {nearby.suburb}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQs -->
  <section class="py-section bg-background" aria-label="Frequently asked questions">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="font-heading text-h3 text-primary mb-8">Common Questions — {location.suburb}</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="glass-card-solid p-6 group">
              <summary class="font-heading text-primary cursor-pointer flex items-center justify-between">
                {faq.q}
                <svg class="w-5 h-5 text-accent transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="text-text-muted mt-4 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + Emergency -->
  <CTABanner
    headline={`Need a Plumber in ${location.suburb}?`}
    subheadline="Get a free, no-obligation quote. Kurt personally responds to every enquiry."
  />
  <EmergencyBanner />
</BaseLayout>
